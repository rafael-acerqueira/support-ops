{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "db:migrate": "uv run alembic -c alembic.ini upgrade head",
    "db:rollback": "uv run alembic -c alembic.ini downgrade -1",
    "db:current": "uv run alembic -c alembic.ini current"
  }
}
